[gd_resource type="Resource" script_class="PlayerClass" format=3]

[ext_resource type="Script" path="res://scripts/classes/player_class.gd" id="1_pc"]
[ext_resource type="Script" path="res://scripts/abilities/vigil_candle_ability.gd" id="2_candle"]
[ext_resource type="Script" path="res://scripts/abilities/ember_brand_ability.gd" id="3_brand"]

[sub_resource type="Resource" id="Resource_candle"]
script = ExtResource("2_candle")
display_name = "Vigil Candle"
id = "vigil_candle"
kind = "deployable"
summary = "Set a candle that sets every zombie near it on fire for 12 seconds."
cooldown = 15.0
duration = 0.0

[sub_resource type="Resource" id="Resource_brand"]
script = ExtResource("3_brand")
display_name = "Ember Brand"
id = "ember_brand"
kind = "mark"
summary = "Brand up to 6 zombies ahead: they burn, and burst into flame if they die branded."
cooldown = 11.0
duration = 0.0

[resource]
script = ExtResource("1_pc")
display_name = "Chandler"
id = "chandler"
role = "Zone control"
description = "Lights fires and holds ground with them. Q: Vigil Candle or Ember Brand. G: Tremor Charge."
max_health = 90
walk_speed = 5.2
sprint_speed = 8.8
jump_velocity = 5.0
grenade_id = "pulse"
ability = SubResource("Resource_candle")
abilities = Array[Resource]([SubResource("Resource_candle"), SubResource("Resource_brand")])
