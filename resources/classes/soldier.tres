[gd_resource type="Resource" script_class="PlayerClass" format=3]

[ext_resource type="Script" path="res://scripts/classes/player_class.gd" id="1_pc"]
[ext_resource type="Script" path="res://scripts/abilities/dash_ability.gd" id="2_dash"]
[ext_resource type="Script" path="res://scripts/abilities/rally_banner_ability.gd" id="3_banner"]

[sub_resource type="Resource" id="Resource_dash"]
script = ExtResource("2_dash")
dash_speed = 22.0
display_name = "Dash"
id = "dash"
kind = "movement"
summary = "Burst a few metres in the direction you are moving."
cooldown = 4.0
duration = 0.18

[sub_resource type="Resource" id="Resource_banner"]
script = ExtResource("3_banner")
display_name = "Rally Banner"
id = "rally_banner"
kind = "deployable"
summary = "Plant a banner: stand near it to build overshield; zombies near it slow down."
cooldown = 16.0
duration = 0.0

[resource]
script = ExtResource("1_pc")
display_name = "Soldier"
id = "soldier"
role = "Front line"
description = "Balanced health and speed. Q: Dash or Rally Banner. G: Frag Grenade."
max_health = 100
walk_speed = 5.0
sprint_speed = 8.5
jump_velocity = 5.0
grenade_id = "frag"
ability = SubResource("Resource_dash")
abilities = Array[Resource]([SubResource("Resource_dash"), SubResource("Resource_banner")])
